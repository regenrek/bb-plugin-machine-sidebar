{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "noEmit": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "app.tsx",
    "components",
    "farcall-contract.ts",
    "farcall-events.ts",
    "farcall-reader.ts",
    "farcall-tasks.tsx",
    "farcall.test.ts",
    "hierarchy-guides.tsx",
    "inactive.tsx",
    "lib",
    "server.ts",
    "settings.tsx",
    "strings.ts",
    "tag-rules.tsx",
    "tags.ts",
    "tree.ts"
  ]
}
